task.spawn(function()
    local layers = {}
    local ok, err = pcall(function()
        local getAsset = getcustomasset or getsynasset
        assert(getAsset and writefile, "executor has no getcustomasset/writefile")
        for i, data in ipairs(WALL_SHEETS) do
            local fileName = "nox_wall_" .. i .. ".jpg"
            writefile(fileName, b64decode(data))
            local l = Instance.new("ImageLabel")
            l.Name = "Sheet" .. i
            l.Size = UDim2.fromScale(1, 1)
            l.BackgroundTransparency = 1
            l.BorderSizePixel = 0
            l.Active = false
            l.ImageTransparency = 1
            l.ImageRectSize = Vector2.new(WALL_FW, WALL_FH)
            l.ZIndex = 1
            l.Image = getAsset(fileName)
            l.Parent = wallHolder
            layers[i] = l
        end
    end)
    if not ok then
        warn("[NOX] MP4 background animation failed: " .. tostring(err))
        wallHolder.Visible = false
        if notify then notify("Background animation unsupported by this executor.") end
        return
    end

    wallDim.Visible = true
    if notify then notify("Uploaded MP4 background playing.") end

    local lastFrame, lastSheet = -1, nil
    local startTime = tick()
    RunService.Heartbeat:Connect(function()
        if not wallHolder.Parent then return end
        local frame = math.floor((tick() - startTime) * WALL_FPS) % WALL_FRAMES
        if frame == lastFrame then return end
        lastFrame = frame
        local sheet = math.floor(frame / WALL_PER_SHEET) + 1
        local idx = frame % WALL_PER_SHEET
        local layer = layers[sheet]
        if not layer then return end
        layer.ImageRectOffset = Vector2.new((idx % WALL_COLS) * WALL_FW, math.floor(idx / WALL_COLS) * WALL_FH)
        if sheet ~= lastSheet then
            if lastSheet and layers[lastSheet] then layers[lastSheet].ImageTransparency = 1 end
            layer.ImageTransparency = 0
            lastSheet = sheet
        end
    end)
end)

