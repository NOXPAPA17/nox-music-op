-- base64 decoder (used for the embedded images / video)
local function b64decode(data)
    local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local map = {}
    for i = 1, 64 do map[chars:sub(i, i)] = i - 1 end
    local out, n, buf, bits = {}, 0, 0, 0
    for i = 1, #data do
        local v = map[data:sub(i, i)]
        if v then
            buf = buf * 64 + v
            bits = bits + 6
            if bits >= 8 then
                bits = bits - 8
                local p = 2 ^ bits
                n = n + 1
                out[n] = string.char(math.floor(buf / p) % 256)
                buf = buf % p
            end
        end
    end
    return table.concat(out)
end


-- remove old copy + pick a parent that works on Xeno / most executors
local function parentTargets()
    local list = {}
    local function add(fn)
        local ok, t = pcall(fn)
        if ok and t then table.insert(list, t) end
    end
    add(function() return gethui and gethui() end)
    add(function() return game:GetService("CoreGui") end)
    add(function() return LocalPlayer:WaitForChild("PlayerGui", 5) end)
    return list
end
for _, t in ipairs(parentTargets()) do
    pcall(function()
        local old = t:FindFirstChild("NoxGUI")
        if old then old:Destroy() end
    end)
end
local function safeParent(g)
    for _, t in ipairs(parentTargets()) do
        local ok = pcall(function() g.Parent = t end)
        if ok and g.Parent == t then return t end
    end
    return nil
end

