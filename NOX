master.Name = "MasterToggle"
master.Size = UDim2.fromOffset(MASTER_SIZE, MASTER_SIZE)
master.Position = UDim2.new(0, 14, 0.5, -MASTER_SIZE / 2)
master.BackgroundTransparency = 1
master.Text = ""
master.AutoButtonColor = false
master.Parent = gui

local function makeLayer(name)
    local l = Instance.new("ImageLabel")
    l.Name = name
    l.AnchorPoint = Vector2.new(0.5, 0.5)
    l.Position = UDim2.fromScale(0.5, 0.5)
    l.Size = UDim2.fromScale(1, 1)
    l.BackgroundTransparency = 1
    l.Active = false
    l.Parent = master
    return l
end

local dragons = makeLayer("Dragons")   -- this one rotates
local nLogo   = makeLayer("N")         -- this one stays still in the middle

-- load one layer from an asset ID, or from the embedded copy
local function loadLayer(layer, assetId, b64, fileName)
    local id = tostring(assetId):match("%d+")
    if id then
        layer.Image = "rbxassetid://" .. id
        return true
    end
    local ok, err = pcall(function()
        local getAsset = getcustomasset or getsynasset
        assert(getAsset and writefile, "executor has no getcustomasset/writefile")
        writefile(fileName, b64decode(b64))
        layer.Image = getAsset(fileName)
    end)
    if not ok then warn("[NOX] master image failed: " .. tostring(err)) end
    return ok
end

local iconOk = loadLayer(dragons, MASTER_DRAGONS_IMAGE, DRAGONS_B64, "nox_dragons.png")
iconOk = loadLayer(nLogo, MASTER_N_IMAGE, N_B64, "nox_n.png") and iconOk

